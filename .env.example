# (ไม่บังคับ) คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env ถูก .gitignore ไว้แล้ว จะไม่ถูก commit)
#
# ใช้สำหรับหน้า "นำเข้า AMR (Admin)" ในเว็บแอป (web/app.py) เป็น "ค่า default" เวลาไม่ได้
# กรอก username/password ในฟอร์มหน้าเว็บ — ถ้ามีหลายบัญชีคนละ username/password กัน
# (เช่นเป็นร้อยบัญชี) แนะนำให้กรอกในฟอร์มแทนทุกครั้งแทนการตั้งค่านี้
#
# วิธีโหลดตัวแปรเหล่านี้ก่อนรัน python web/app.py:
#   Windows (cmd.exe):     set ADMIN_EDIT_PASSWORD=... && set PEA_AMR_USERNAME=... && python web\app.py
#   Windows (PowerShell):  $env:PEA_AMR_USERNAME="..."; $env:PEA_AMR_PASSWORD="..."
#   macOS/Linux:           export PEA_AMR_USERNAME=... PEA_AMR_PASSWORD=...
#   หรือใช้ไลบรารี python-dotenv โหลดจากไฟล์ .env อัตโนมัติ

PEA_AMR_USERNAME=your-pea-amr-username
PEA_AMR_PASSWORD=your-pea-amr-password

# (ไม่บังคับ) รหัสผ่านสำหรับยืนยันก่อนแก้ไขข้อมูลลูกค้าในหน้า "ภาพรวมลูกค้าทั้งหมด" (/overview)
# โดยตรง — ถ้าไม่ตั้งค่านี้เลย (ค่าเริ่มต้น) จะแก้ไขได้อิสระโดยไม่ต้องใส่รหัสผ่าน (สะดวกกว่าตอน
# ใช้คนเดียวในเครื่องตัวเอง) ตั้งค่านี้เมื่อไหร่ก็ได้ทีหลังถ้าอยากให้ต้องใส่รหัสผ่านก่อนแก้ไขทุกครั้ง
ADMIN_EDIT_PASSWORD=choose-your-own-password
